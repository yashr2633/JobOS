# Supabase Configuration
# Get these values from your Supabase dashboard: Project Settings > API Keys

# Your Supabase project URL (e.g., https://xxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Current key format (Project Settings > API Keys > Publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Legacy alternative (only needed for older projects that still expose an anon key).
# If both are set, the publishable key wins.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
