# Supabase Configuration
# Get these values from your Supabase dashboard: Project Settings > API Keys

# Your Supabase project URL (e.g., https://xxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Current key format (Project Settings > API Keys > Publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Legacy alternative (only needed for older projects that still expose an anon key).
# If both are set, the publishable key wins.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (Project Settings > API Keys > service_role) — SERVER ONLY.
# Must NOT use the NEXT_PUBLIC_ prefix: it is a privileged secret that bypasses
# RLS and must never reach the browser bundle. Used only by server code
# (src/lib/supabase/admin.ts) to read/write the Gmail OAuth token columns, whose
# column-level SELECT is revoked from the authenticated/anon roles. Leave blank
# here; set the real value only in .env.local (and in your deployment secrets).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI Job Intelligence (Sprint 5) — SERVER ONLY
# ---------------------------------------------------------------------------
# These must NOT use the NEXT_PUBLIC_ prefix. Anything prefixed NEXT_PUBLIC_ is
# inlined into the browser bundle, which would expose the key to every visitor.
# They are read only from server-side code under src/lib/ai/ and API routes.

# --- Provider credentials (at least one required) --------------------------
# Gemini (PRIMARY): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Groq (FALLBACK): https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# OpenRouter (LAST FALLBACK): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# Anthropic (LEGACY/OPTIONAL — not in the default chain)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Routing policy (all optional; safe defaults shown) --------------------
# Providers are tried in order: primary first, then each fallback.
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq,openrouter
# Anthropic is excluded from the chain unless this is true.
AI_ENABLE_ANTHROPIC=false
# Retries against the SAME provider for transient errors only (0-3).
AI_MAX_RETRIES=1
# Per-request deadline in ms (1000-60000).
AI_REQUEST_TIMEOUT_MS=20000

# --- Model overrides (optional) --------------------------------------------
# Two tiers keep cost proportional to task difficulty.
# Lightweight tier: structured extraction (JD + resume parsing).
GEMINI_LIGHT_MODEL=gemini-2.5-flash-lite
# Deep tier: interpretation, recommendations, tailored-resume generation.
GEMINI_DEEP_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openrouter/free
ANTHROPIC_PARSING_MODEL=claude-haiku-4-5
ANTHROPIC_REASONING_MODEL=claude-sonnet-4-5

# Maximum analysis runs per user per rolling 24 hours. Bounds AI spend.
AI_DAILY_ANALYSIS_LIMIT=20

# ---------------------------------------------------------------------------
# Gmail OAuth Integration (Sprint 6)
# ---------------------------------------------------------------------------
# Get these values from Google Cloud Console: https://console.cloud.google.com/
# Required OAuth scopes: https://www.googleapis.com/auth/gmail.readonly

# Google OAuth Client ID (public, safe to expose)
GOOGLE_CLIENT_ID=your_google_client_id

# Google OAuth Client Secret (server-only, must NOT use NEXT_PUBLIC_ prefix)
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional: OAuth redirect URI (local default; Vercel production defaults to
# https://jobtrackos.vercel.app/api/gmail/callback)
# This must match the redirect URI configured in Google Cloud Console
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback
